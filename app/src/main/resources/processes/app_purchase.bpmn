      <bpmn:incoming>Flow_0yremsv</bpmn:incoming>
      <bpmn:outgoing>Flow_0f7b2qy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_free">
      <bpmn:incoming>Flow_1w8nnkx</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_already">
      <bpmn:incoming>purchased</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0tdlbsb" sourceRef="Activity_0ocm1js" targetRef="task_load_context" />
    <bpmn:sequenceFlow id="Flow_1tdytrr" sourceRef="task_load_context" targetRef="gw_already_purchased" />
    <bpmn:sequenceFlow id="purchased" name="Да" sourceRef="gw_already_purchased" targetRef="end_already">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alreadyPurchased}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="not_purchased" name="Нет" sourceRef="gw_already_purchased" targetRef="gw_price_free">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!alreadyPurchased}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1w8nnkx" name="Да" sourceRef="gw_price_free" targetRef="end_free">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isFree}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0yremsv" name="Нет" sourceRef="gw_price_free" targetRef="task_charge_payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!isFree}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0f7b2qy" sourceRef="task_charge_payment" targetRef="end_purchased" />
    <bpmn:startEvent id="start_purchase_app" name="" camunda:initiator="username">
      <bpmn:outgoing>Flow_149vykz</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_149vykz" sourceRef="start_purchase_app" targetRef="Activity_0ocm1js" />
    <bpmn:userTask id="Activity_0ocm1js" name="Выбрать приложение" camunda:assignee="${username}">
