        <bpmn:flowNodeRef>task_load_context</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_already_purchased</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_price_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_charge_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_already</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ntgzl4" name="Пользователь">
        <bpmn:flowNodeRef>start_purchase_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ocm1js</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_purchased</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="task_load_context" name="Получить приложение" camunda:delegateExpression="${loadAppDataDelegate}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0tdlbsb</bpmn:incoming>
      <bpmn:outgoing>Flow_1tdytrr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_already_purchased" name="Приобретено?">
      <bpmn:incoming>Flow_1tdytrr</bpmn:incoming>
      <bpmn:outgoing>purchased</bpmn:outgoing>
      <bpmn:outgoing>not_purchased</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_price_free" name="Бесплатно?">
      <bpmn:incoming>not_purchased</bpmn:incoming>
      <bpmn:outgoing>Flow_1w8nnkx</bpmn:outgoing>
      <bpmn:outgoing>Flow_0yremsv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_charge_payment" name="Оплатить" camunda:delegateExpression="${chargePaymentDelegate}">
