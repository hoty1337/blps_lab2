  <bpmn:collaboration id="start_publish">
    <bpmn:participant id="Participant_0i5a6kb" name="Информационная система - Upload" processRef="publish_app" />
  </bpmn:collaboration>
  <bpmn:process id="publish_app" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1tj9f5q">
      <bpmn:lane id="Lane_1ex6ktb" name="Пользователь">
        <bpmn:flowNodeRef>start_publish_app</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_published</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1qs7fbe" name="Сервер">
        <bpmn:flowNodeRef>task_send_xmpp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_upload_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_save_app</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1kxfkcm" sourceRef="start_publish_app" targetRef="task_upload_files" />
    <bpmn:serviceTask id="task_send_xmpp" name="Отправить XMPP" camunda:asyncBefore="true" camunda:delegateExpression="${sendXmppDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT30S</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1n3wz52</bpmn:incoming>
      <bpmn:outgoing>Flow_1l9aoa7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0fyojoj" sourceRef="task_upload_files" targetRef="task_save_app" />
    <bpmn:sequenceFlow id="Flow_1n3wz52" sourceRef="task_save_app" targetRef="task_send_xmpp" />
    <bpmn:sequenceFlow id="Flow_1l9aoa7" sourceRef="task_send_xmpp" targetRef="end_published" />
    <bpmn:startEvent id="start_publish_app" camunda:initiator="username">
      <bpmn:outgoing>Flow_1kxfkcm</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="end_published" name="Опубликовано">
      <bpmn:incoming>Flow_1l9aoa7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_upload_files" name="Загрузить файлы в MinIO" camunda:delegateExpression="${uploadAppDelegate}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1kxfkcm</bpmn:incoming>
      <bpmn:outgoing>Flow_0fyojoj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_save_app" name="Сохранить приложение в БД" camunda:delegateExpression="${persistAppDelegate}">
      <bpmn:incoming>Flow_0fyojoj</bpmn:incoming>
      <bpmn:outgoing>Flow_1n3wz52</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmn:message id="Message_39corp9" name="MSG_APP_PUBLISH_REQUEST" />
