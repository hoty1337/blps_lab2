<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_15i4y65" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:collaboration id="Collaboration_1sxwqzj">
    <bpmn:participant id="Participant_0zo06fs" name="Информационная система - удаление приложения" processRef="app_remove" />
  </bpmn:collaboration>
  <bpmn:process id="app_remove" name="Remove App by Id" isExecutable="true" camunda:candidateStarterGroups="DEVELOPER,ADMIN">
    <bpmn:laneSet id="LaneSet_0yxej95">
      <bpmn:lane id="Lane_0zxet1q">
        <bpmn:flowNodeRef>start_app_remove</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_014st9g">
        <bpmn:flowNodeRef>task_find_by_fileId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_app_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_nothing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_delete_minio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_removed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="task_find_by_fileId" name="Найти приложение по id" camunda:delegateExpression="${removalLoadAppDataDelegate}">
      <bpmn:incoming>Flow_1oacbbz</bpmn:incoming>
      <bpmn:outgoing>Flow_12647kk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_app_found" name="Приложение найдено?">
      <bpmn:incoming>Flow_12647kk</bpmn:incoming>
      <bpmn:outgoing>Flow_0gox0i4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hecv80</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_nothing" name="Приложение уже удалено">
      <bpmn:incoming>Flow_0hecv80</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="task_delete_minio" name="Удалить приложение" camunda:delegateExpression="${removeAppDelegate}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0gox0i4</bpmn:incoming>
      <bpmn:outgoing>Flow_13ghgdu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="start_app_remove" name="Start" camunda:initiator="username">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="appId" label="Айди приложения" type="long">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1oacbbz</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1oacbbz" sourceRef="start_app_remove" targetRef="task_find_by_fileId" />
    <bpmn:sequenceFlow id="Flow_12647kk" sourceRef="task_find_by_fileId" targetRef="gw_app_found" />
    <bpmn:sequenceFlow id="Flow_0gox0i4" name="Да" sourceRef="gw_app_found" targetRef="task_delete_minio">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${appFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0hecv80" name="Нет" sourceRef="gw_app_found" targetRef="end_nothing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!appFound}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13ghgdu" sourceRef="task_delete_minio" targetRef="end_removed" />
    <bpmn:endEvent id="end_removed" name="Успешно удалено">
      <bpmn:incoming>Flow_13ghgdu</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_37svv4l" name="MSG_APP_REMOVE_REQUEST" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
