  <bpmn:collaboration id="Collaboration_0ygg1y1">
    <bpmn:participant id="Participant_1xwzieo" name="Информационная система - Пополнить баланс" processRef="wallet_top_up" />
  </bpmn:collaboration>
  <bpmn:process id="wallet_top_up" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1823qsk">
      <bpmn:lane id="Lane_1ah2qpn" name="Пользователь">
        <bpmn:flowNodeRef>user_task_enter_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>start_msg_wallet_top_up</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_topped_up</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ktogv8" name="Сервер">
        <bpmn:flowNodeRef>task_deposit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_0lwbpuf" sourceRef="start_msg_wallet_top_up" targetRef="user_task_enter_amount" />
    <bpmn:userTask id="user_task_enter_amount" name="Пополнить счет" camunda:assignee="${username}" camunda:candidateGroups="">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="cardNumber" label="Номер карты" type="string" defaultValue="11111111111111">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="amount" label="Количество к пополнению" type="long" defaultValue="5">
            <camunda:properties />
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lwbpuf</bpmn:incoming>
      <bpmn:outgoing>Flow_1yzwdiy</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1yzwdiy" sourceRef="user_task_enter_amount" targetRef="task_deposit" />
    <bpmn:sequenceFlow id="Flow_1hdzpmu" sourceRef="task_deposit" targetRef="end_topped_up" />
    <bpmn:startEvent id="start_msg_wallet_top_up" camunda:initiator="username">
      <bpmn:outgoing>Flow_0lwbpuf</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="task_deposit" name="Внести средства" camunda:delegateExpression="${depositDelegate}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1yzwdiy</bpmn:incoming>
      <bpmn:outgoing>Flow_1hdzpmu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_topped_up" name="">
      <bpmn:incoming>Flow_1hdzpmu</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_2i8riq5" name="MSG_WALLET_TOP_UP" />
