    <bpmn:serviceTask id="task_add_card" name="Добавить карту" camunda:delegateExpression="${addCardDelegate}">
      <bpmn:incoming>Flow_17jkh4a</bpmn:incoming>
      <bpmn:outgoing>Flow_0a6myiz</bpmn:outgoing>
