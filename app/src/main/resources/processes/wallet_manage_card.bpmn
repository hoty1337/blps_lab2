  <bpmn:collaboration id="Collaboration_19zaxvp">
    <bpmn:participant id="Participant_0jxsb4j" name="Информационная система - Управление картами" processRef="wallet_manager_card" />
  </bpmn:collaboration>
  <bpmn:process id="wallet_manager_card" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1j20a95">
      <bpmn:lane id="Lane_1kvk65x" name="Сервер">
        <bpmn:flowNodeRef>task_delete_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_set_primary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_add_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1hv8pqt" name="Пользователь">
        <bpmn:flowNodeRef>Gateway_0hhrge0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_delete_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_add_card</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_set_primary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wallet_manage</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_0hhrge0">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_15pzaly</bpmn:incoming>
      <bpmn:outgoing>Flow_0zmwlql</bpmn:outgoing>
