    <bpmn:endEvent id="end_done" name="end_done">
      <bpmn:incoming>Flow_0a6myiz</bpmn:incoming>
      <bpmn:incoming>Flow_0masn2u</bpmn:incoming>
      <bpmn:incoming>Flow_02620ni</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="wallet_manage" camunda:initiator="username">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="action" label="Выберите действие" type="enum" defaultValue="add">
            <camunda:value id="add" name="Добавить карту" />
            <camunda:value id="primary" name="Сделать основной" />
            <camunda:value id="delete" name="Удалить карту" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_15pzaly</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_15pzaly" sourceRef="wallet_manage" targetRef="Gateway_0hhrge0" />
    <bpmn:sequenceFlow id="Flow_0zmwlql" sourceRef="Gateway_0hhrge0" targetRef="user_add_card">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'add'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1263w5z" sourceRef="Gateway_0hhrge0" targetRef="user_set_primary">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'primary'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0g596az" sourceRef="Gateway_0hhrge0" targetRef="user_delete_card">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'delete'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1iq5dxl" sourceRef="user_delete_card" targetRef="task_delete_card" />
    <bpmn:sequenceFlow id="Flow_02620ni" sourceRef="task_delete_card" targetRef="end_done" />
    <bpmn:sequenceFlow id="Flow_17jkh4a" sourceRef="user_add_card" targetRef="task_add_card" />
    <bpmn:sequenceFlow id="Flow_0q04zx4" sourceRef="user_set_primary" targetRef="task_set_primary" />
    <bpmn:sequenceFlow id="Flow_0masn2u" sourceRef="task_set_primary" targetRef="end_done" />
    <bpmn:sequenceFlow id="Flow_0a6myiz" sourceRef="task_add_card" targetRef="end_done" />
  </bpmn:process>
