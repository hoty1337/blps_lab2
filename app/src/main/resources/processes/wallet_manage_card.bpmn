      <bpmn:outgoing>Flow_0g596az</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="user_delete_card" name="Удалить карту" camunda:assignee="${username}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="cardId" label="Айди карты в кошельке" type="long" defaultValue="1">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0g596az</bpmn:incoming>
      <bpmn:outgoing>Flow_1iq5dxl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_delete_card" name="Удалить карту" camunda:delegateExpression="${deleteCardDelegate}">
      <bpmn:incoming>Flow_1iq5dxl</bpmn:incoming>
      <bpmn:outgoing>Flow_02620ni</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="user_add_card" name="Добавить карту" camunda:assignee="${username}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="cardNumber" label="Номер карты" type="string" defaultValue="1111111111111111">
            <camunda:properties />
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="cardHolder" label="Владелец карты" type="string" defaultValue="IVAN IVANOV">
            <camunda:properties />
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="expirationDate" label="Срок действия MM/YY" type="string" defaultValue="12/28">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="cvv" label="CVV/CVC (3 или 4 цифры)" type="string" defaultValue="228">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0zmwlql</bpmn:incoming>
      <bpmn:outgoing>Flow_17jkh4a</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="user_set_primary" name="Сделать основной" camunda:assignee="${username}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="cardId" label="Айди карты в кошельке" type="long" defaultValue="1">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1263w5z</bpmn:incoming>
      <bpmn:outgoing>Flow_0q04zx4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_set_primary" name="Сделать основной" camunda:delegateExpression="${primaryCardDelegate}">
      <bpmn:incoming>Flow_0q04zx4</bpmn:incoming>
      <bpmn:outgoing>Flow_0masn2u</bpmn:outgoing>
